{
  "compilerOptions": {
    "outDir": "../dist/",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "module": "esnext",
    "target": "es2020",
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "types": ["node", "jest"],
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "dom.iterable",
      "es2021",
      "webworker"
    ]
  },
  "include": [
    "./src/*"
  ],
  "exclude": [
    "/node_modules"
  ]
}